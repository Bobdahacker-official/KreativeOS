#!/bin/sh
case "$1" in ''|*[!a-zA-Z0-9._-]*) exit 1;; esac
pidfile="/run/dhcp-$1.pid"
case "$2" in
    CONNECTED)
        if [ -s "$pidfile" ]; then
            kill -USR1 "$(cat "$pidfile")" 2>/dev/null && exit 0
        fi
        udhcpc -b -T 2 -i "$1" -s /sbin/kos-dhcp -p "$pidfile" >/dev/null 2>&1
        ;;
    DISCONNECTED)
        if [ -s "$pidfile" ]; then kill "$(cat "$pidfile")" 2>/dev/null; fi
        rm -f "$pidfile"
        interface="$1" /sbin/kos-dhcp deconfig
        ;;
esac
